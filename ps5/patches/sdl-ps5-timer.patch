+#ifdef __PROSPERO__
+/* PlayStation 5: clock_gettime is a system call there, microseconds each,
+ * and games read the counter around every draw. The CPU's invariant time
+ * stamp counter is one instruction; libkernel reports its frequency. */
+extern Uint64 sceKernelGetTscFrequency(void);
+
+Uint64 SDL_GetPerformanceCounter(void)
+{
+    return (Uint64)__builtin_ia32_rdtsc();
+}
+
+Uint64 SDL_GetPerformanceFrequency(void)
+{
+    static Uint64 frequency = 0;
+    if (frequency == 0) {
+        frequency = sceKernelGetTscFrequency();
+    }
+    return frequency;
+}
